{
  "expo": {
    "name": "Spanish Verbs Trainer",
    "slug": "spanish-verbs-trainer",
    "version": "1.21.0",
    "orientation": "portrait",
    "scheme": "spanishverbstrainer",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bulat.spanishverbstrainer"
    },
    "android": {
      "package": "com.bulat.spanishverbstrainer",
      "versionCode": 23,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    }
  }
}
